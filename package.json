{
  "name": "ai-web-design-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AIでWebデザイン案件をこなすための制作システム（デザインレシピDB 40,000件 + モーション/グラフィック/効果音ライブラリ + テンプレート）",
  "scripts": {
    "build:db": "node tools/build-db.mjs",
    "search": "node tools/search.mjs",
    "new": "node tools/new-project.mjs",
    "render": "node tools/render.mjs",
    "serve": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "works": "node tools/works.mjs",
    "kit": "node tools/export-kit.mjs --zip",
    "production:new": "node scripts/new-project.mjs",
    "production:assets": "node scripts/check-assets.mjs",
    "test:production": "node --test tests/*.test.mjs",
    "build:production": "npm run build --prefix production/template",
    "test:production:e2e": "npm run test:e2e --prefix production/template"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
