  "motions": {
    "fade-up": {
      "impl": "data-reveal=\"fade-up\"",
      "desc": "下から20〜40pxフェードイン。全ジャンルの基本"
    },
    "clip-up": {
      "impl": "data-reveal=\"clip-up\"",
      "desc": "下から幕が上がるように出現。写真・見出しに"
    },
    "clip-left": {
      "impl": "data-reveal=\"clip-left\"",
      "desc": "左から右へ切り抜き出現。エディトリアル向け"
    },
    "clip-circle": {
      "impl": "data-reveal=\"clip-circle\"",
      "desc": "円形に広がって出現"
    },
    "mask-wipe": {
      "impl": "data-reveal=\"mask-wipe\"",
      "desc": "色帯が通過して中身が現れる。高級感"
    },
    "split-text": {
      "impl": "data-split=\"chars\" data-reveal",
      "desc": "1文字ずつ下から出る見出し（キネティックタイポ）"
    },
    "blur-in": {
      "impl": "data-reveal=\"blur-in\"",
      "desc": "ぼかしから焦点が合う。上品・映画的"
    },
    "zoom-in": {
      "impl": "data-reveal=\"zoom-in\"",
      "desc": "縮小状態から拡大して出現"
    },
    "rotate-in": {
      "impl": "data-reveal=\"rotate-in\"",
      "desc": "少し傾いて出現。遊び心"
    },
    "pop": {
      "impl": "data-reveal=\"pop\"",
      "desc": "弾むように出現（バックイージング）"
    },
    "stagger": {
      "impl": "data-stagger=\"80\"",
      "desc": "カード等を順番に出す"
    },
    "parallax": {
      "impl": "data-parallax=\"0.15\"",
      "desc": "スクロール視差。奥行き表現"
    },
    "counter-up": {
      "impl": "data-counter=\"1200\"",
      "desc": "実績数字のカウントアップ"
    },
    "typewriter": {
      "impl": "data-typewriter data-sfx-type",
      "desc": "タイプ表示＋打鍵音"
    },
    "line-draw": {
      "impl": "data-line-draw（SVG）",
      "desc": "SVGの線が描かれていく"
    },
    "marquee": {
      "impl": "data-marquee=\"40\"",
      "desc": "無限に流れるテキスト帯"
    },
    "magnetic": {
      "impl": "data-magnetic",
      "desc": "ボタンがカーソルに吸い付く"
    },
    "tilt-3d": {
      "impl": "data-tilt",
      "desc": "カードが3Dに傾く＋光沢"
    },
    "cursor-follow": {
      "impl": "<body data-cursor>",
      "desc": "カスタムカーソル（PCのみ）"
    },
    "scroll-progress": {
      "impl": "<div data-scroll-progress>",
      "desc": "読了進捗バー"
    },
    "sticky-scrub": {
      "impl": "section[data-pin] + CSS var(--p)",
      "desc": "スクロールに合わせて固定画面の中身が変化"
    },
    "horizontal-scroll": {
      "impl": "data-hscroll + data-hscroll-track",
      "desc": "縦スクロールで横に流れるギャラリー"
    },
    "image-hover-zoom": {
      "impl": "CSS: img{transition:transform .8s} a:hover img{transform:scale(1.06)}",
      "desc": "画像ホバーでゆっくり拡大"
    },
    "ken-burns": {
      "impl": "class=\"m-kenburns\"",
      "desc": "写真がゆっくりズーム&パン"
    },
    "shine-sweep": {
      "impl": "class=\"m-shine\"",
      "desc": "光が斜めに走る（CTA・ゴールド）"
    },
    "chrome-shine": {
      "impl": "class=\"m-shine\" + メタリックグラデ",
      "desc": "クローム文字の反射"
    },
    "float": {
      "impl": "class=\"m-float\"",
      "desc": "ふわふわ浮遊ループ"
    },
    "bounce": {
      "impl": "class=\"m-bounce\"",
      "desc": "跳ねるループ（矢印・バッジ）"
    },
    "wiggle": {
      "impl": "class=\"m-wiggle\"",
      "desc": "定期的にぷるっと揺れて注目を集める"
    },
    "spin": {
      "impl": "class=\"m-spin\"",
      "desc": "回転ループ（円形テキストバッジ）"
    },
    "pulse": {
      "impl": "class=\"m-pulse\"",
      "desc": "CTAの波紋パルス"
    },
    "gradient-shift": {
      "impl": "class=\"m-gradient-shift\"",
      "desc": "グラデーションがゆっくり流れる"
    },
    "blob-morph": {
      "impl": "class=\"m-blob\"",
      "desc": "有機的な形が変形し続ける"
